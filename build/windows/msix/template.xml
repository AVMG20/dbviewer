<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="dbviewer"
        Arguments=""
        InstallLocation="C:\Program Files\dbviewer\dbviewer">
    </Installer>
    <PackageInformation
        PackageName="dbviewer"
        PackageDisplayName="dbviewer"
        PublisherName="CN=dbviewer"
        PublisherDisplayName="dbviewer"
        Version="0.1.0.0"
        PackageDescription="Database viewer">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="nl.avmg.dbviewer"
                Description="Database viewer"
                DisplayName="dbviewer"
                ExecutableName="dbviewer"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>dbviewer</DisplayName>
            <PublisherDisplayName>dbviewer</PublisherDisplayName>
            <Description>Database viewer</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="dbviewer.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
